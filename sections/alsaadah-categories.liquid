      "default": "Entdecken Sie unser Sortiment."
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Kategorie",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Eigene Kategorie-Bild"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel überschreiben",
          "info": "Leer lassen, um den Collection-Namen zu verwenden."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ALSAADAH Categories",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}