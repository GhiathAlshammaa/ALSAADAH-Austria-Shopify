<section
  id="AlsaadahCategories-{{ section.id }}"
  class="alsaadah-categories"
>
  <div class="alsaadah-categories__inner page-width">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <header class="alsaadah-categories__header">
        {% if section.settings.heading != blank %}
          <h2 class="alsaadah-categories__heading">
            {{ section.settings.heading | escape }}
          </h2>
        {% endif %}

        {% if section.settings.subheading != blank %}
          <p class="alsaadah-categories__subheading">
            {{ section.settings.subheading | escape }}
          </p>
        {% endif %}
      </header>
    {% endif %}

    <div class="alsaadah-categories__grid">
      {% for block in section.blocks %}
        {% liquid
          assign collection = block.settings.collection
          assign custom_image = block.settings.image

          if block.settings.title != blank
            assign card_title = block.settings.title
          elsif collection != blank
            assign card_title = collection.title
          else
            assign card_title = 'Kategorie'
          endif

          if collection != blank
            assign card_url = collection.url
          else
            assign card_url = '#'
          endif

          assign card_image = custom_image

          if card_image == blank and collection != blank
            assign card_image = collection.featured_image
          endif

          if card_image == blank and collection != blank and collection.products.first
            assign card_image = collection.products.first.featured_image
          endif
        %}

        <article
          class="alsaadah-category-card"
          {{ block.shopify_attributes }}
        >
          <a
            href="{{ card_url }}"
            class="alsaadah-category-card__link"
            {% if collection == blank %}
              aria-disabled="true"
            {% endif %}
          >
            <div class="alsaadah-category-card__media">
              {% if card_image != blank %}
                {{
                  card_image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'alsaadah-category-card__image',
                    loading: 'lazy',
                    widths: '320, 480, 640, 800, 1000, 1200',
                    sizes: '(min-width: 1200px) 20vw, (min-width: 990px) 33vw, (min-width: 750px) 50vw, 78vw',
                    alt: card_title
                }}
                {% else %}
                  <div class="alsaadah-category-card__placeholder"></div>
                {% endif %}

              <div class="alsaadah-category-card__shade"></div>

              <div class="alsaadah-category-card__content">
                <h3 class="alsaadah-category-card__title">
                  {{ card_title | escape }}
                </h3>

                <span
                  class="alsaadah-category-card__arrow"
                  aria-hidden="true"
                >
                  →
                </span>
              </div>
            </div>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .alsaadah-categories {
    background: #ffffff;

    padding-block:
      clamp(52px, 6vw, 88px);
  }

  .alsaadah-categories__inner {
    width: min(1560px, calc(100% - 48px));
    margin-inline: auto;
  }

  /* ---------------------------------------------------------
     HEADER
     --------------------------------------------------------- */

  .alsaadah-categories__header {
    margin-bottom: 30px;
  }

  .alsaadah-categories__heading {
    margin: 0;
    color: #083b29;
    font-size: clamp(36px, 3.4vw, 52px);
    line-height: 0.98;
    font-weight: 780;
    letter-spacing: -0.045em;
  }

  .alsaadah-categories__subheading {
    max-width: 540px;
    margin: 14px 0 0;
    color: #66756d;
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.55;
  }

  /* ---------------------------------------------------------
     GRID
     Large screens: 5 visual category cards
     --------------------------------------------------------- */

  .alsaadah-categories__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));

    gap: 16px;
  }

  .alsaadah-category-card {
    min-width: 0;
  }

  .alsaadah-category-card__link {
    display: block;

    color: inherit;
    text-decoration: none;
  }

  .alsaadah-category-card__media {
    position: relative;

    aspect-ratio: 4 / 5;

    overflow: hidden;

    border-radius: 18px;

    background: #edf0e9;

    box-shadow:
      0 8px 28px rgba(12, 43, 28, 0.08);

    transform: translateZ(0);
  }

  .alsaadah-category-card__placeholder {
  width: 100%;
  height: 100%;
  background:
    linear-gradient(
      145deg,
      #eef2ea 0%,
      #dfe8dc 55%,
      #cbd9c6 100%
    );
}

  .alsaadah-category-card__image,
  .alsaadah-category-card__placeholder,
  .alsaadah-category-card__placeholder svg {
    display: block;

    width: 100%;
    height: 100%;
  }

  .alsaadah-category-card__image {
    display: block;
    width: 100%;
    height: 100%;
  
    object-fit: cover;
  
    transition:
      transform 450ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /*
   * Keeps titles readable while preserving
   * the visual nature of the card.
   */
  .alsaadah-category-card__shade {
    position: absolute;
    inset: 0;

    background:
      linear-gradient(
        180deg,
        rgba(8, 34, 22, 0) 42%,
        rgba(8, 34, 22, 0.18) 62%,
        rgba(8, 34, 22, 0.82) 100%
      );

    pointer-events: none;

    transition:
      background 300ms ease;
  }

  .alsaadah-category-card__content {
    position: absolute;

    right: 18px;
    bottom: 17px;
    left: 18px;

    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;

    color: #ffffff;
  }

  .alsaadah-category-card__title {
    margin: 0;

    max-width: calc(100% - 42px);

    color: inherit;

    font-size: clamp(18px, 1.45vw, 23px);
    line-height: 1.08;
    font-weight: 700;

    letter-spacing: -0.02em;

    text-wrap: balance;
  }

  .alsaadah-category-card__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 34px;

    width: 34px;
    height: 34px;

    border: 1px solid rgba(255, 255, 255, 0.44);
    border-radius: 50%;

    background: rgba(255, 255, 255, 0.12);

    color: #ffffff;

    font-size: 20px;
    line-height: 1;

    backdrop-filter: blur(6px);

    transition:
      transform 200ms ease,
      background-color 200ms ease,
      border-color 200ms ease;
  }

  /* ---------------------------------------------------------
     INTERACTION
     --------------------------------------------------------- */

  @media (hover: hover) {
    .alsaadah-category-card__link:hover
      .alsaadah-category-card__image {
      transform: scale(1.045);
    }

    .alsaadah-category-card__link:hover
      .alsaadah-category-card__arrow {
      transform: translateX(4px);

      background: #e30613;
      border-color: #e30613;
    }

    .alsaadah-category-card__link:hover
      .alsaadah-category-card__shade {
      background:
        linear-gradient(
          180deg,
          rgba(8, 34, 22, 0) 36%,
          rgba(8, 34, 22, 0.22) 60%,
          rgba(8, 34, 22, 0.88) 100%
        );
    }
  }

  .alsaadah-category-card__link:focus-visible {
    outline: 3px solid #e30613;
    outline-offset: 4px;

    border-radius: 18px;
  }

  /* ---------------------------------------------------------
     SMALL DESKTOP / TABLET LANDSCAPE
     --------------------------------------------------------- */

  @media screen and (max-width: 1199px) {
    .alsaadah-categories__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .alsaadah-category-card__media {
      aspect-ratio: 5 / 6;
    }

    .alsaadah-category-card__title {
      font-size: 21px;
    }
  }

  /* ---------------------------------------------------------
     TABLET
     --------------------------------------------------------- */

  @media screen and (max-width: 899px) {
    .alsaadah-categories {
      padding-block: 58px;
    }

    .alsaadah-categories__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 14px;
    }

    .alsaadah-category-card__media {
      aspect-ratio: 4 / 5;
    }
  }

  /* ---------------------------------------------------------
     MOBILE
     Horizontal discovery rail.
     Designed for touch/swipe instead of tiny cards.
     --------------------------------------------------------- */

  @media screen and (max-width: 749px) {
    .alsaadah-categories {
      padding-block: 46px;
      overflow: hidden;
    }

    .alsaadah-categories__inner {
      width: calc(100% - 28px);
    }

    .alsaadah-categories__header {
      margin-bottom: 22px;
    }

    .alsaadah-categories__heading {
      font-size: 30px;
    }

    .alsaadah-categories__subheading {
      margin-top: 7px;

      font-size: 15px;
    }

    .alsaadah-categories__grid {
      display: flex;

      gap: 12px;

      margin-inline:
        calc(var(--page-margin, 20px) * -1);

      padding-inline:
        var(--page-margin, 20px);

      overflow-x: auto;
      overflow-y: hidden;

      scroll-snap-type: x mandatory;
      scroll-padding-inline:
        var(--page-margin, 20px);

      scrollbar-width: none;

      -webkit-overflow-scrolling: touch;
    }

    .alsaadah-categories__grid::-webkit-scrollbar {
      display: none;
    }

    .alsaadah-category-card {
      flex:
        0
        0
        min(76vw, 310px);

      scroll-snap-align: start;
    }

    .alsaadah-category-card__media {
      aspect-ratio: 4 / 5;

      border-radius: 16px;
    }

    .alsaadah-category-card__content {
      right: 16px;
      bottom: 15px;
      left: 16px;
    }

    .alsaadah-category-card__title {
      font-size: 21px;
    }
  }

  /* ---------------------------------------------------------
     SMALL MOBILE
     --------------------------------------------------------- */

  @media screen and (max-width: 420px) {
    .alsaadah-categories {
      padding-block: 40px;
    }

    .alsaadah-categories__heading {
      font-size: 28px;
    }

    .alsaadah-category-card {
      flex-basis:
        min(80vw, 290px);
    }
  }

  /* ---------------------------------------------------------
     ACCESSIBILITY
     --------------------------------------------------------- */

  @media (prefers-reduced-motion: reduce) {
    .alsaadah-category-card__image,
    .alsaadah-category-card__arrow {
      transition: none;
    }

    .alsaadah-category-card__link:hover
      .alsaadah-category-card__image,
    .alsaadah-category-card__link:hover
      .alsaadah-category-card__arrow {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
