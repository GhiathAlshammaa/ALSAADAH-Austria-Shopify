{% liquid
  assign hero_image = section.settings.image
  assign hero_link = section.settings.button_link | default: routes.all_products_collection_url
%}

<section
  id="AlsaadahHero-{{ section.id }}"
  class="alsaadah-hero"
>
  <div class="alsaadah-hero__media">
    {% if hero_image != blank %}
      {{
        hero_image
        | image_url: width: 2400
        | image_tag:
          class: 'alsaadah-hero__image',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw'
      }}
    {% else %}
      <div class="alsaadah-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="alsaadah-hero__overlay"></div>

  <div class="alsaadah-hero__inner page-width">
    <div class="alsaadah-hero__content">
      {% if section.settings.eyebrow != blank %}
        <p class="alsaadah-hero__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="alsaadah-hero__heading">
          {{ section.settings.heading | escape }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="alsaadah-hero__description">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          href="{{ hero_link }}"
          class="alsaadah-hero__button"
        >
          <span>{{ section.settings.button_label | escape }}</span>

          <span
            class="alsaadah-hero__button-arrow"
            aria-hidden="true"
          >
            →
          </span>
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  /* =========================================================
     ALSAADAH HERO
     Desktop first, responsive down to small mobile
     ========================================================= */

  .alsaadah-hero {
    position: relative;
    display: flex;
    align-items: center;

    width: 100%;
    min-height: 560px;
    overflow: hidden;
    isolation: isolate;

    background: #123b2c;
  }

  /* ---------------------------------------------------------
     MEDIA
     --------------------------------------------------------- */

  .alsaadah-hero__media,
  .alsaadah-hero__overlay {
    position: absolute;
    inset: 0;
  }

  .alsaadah-hero__media {
    z-index: -2;
    background: #123b2c;
  }

  .alsaadah-hero__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    /*
     * Food composition is concentrated on the right side
     * of the generated hero image.
     */
    object-position: 68% center;
  }

  /*
   * Never show Horizon's unrelated placeholder artwork.
   */
  .alsaadah-hero__placeholder,
  .alsaadah-hero__placeholder svg {
    display: none !important;
  }

  /* ---------------------------------------------------------
     OVERLAY
     Keeps the left readable without darkening the food too much
     --------------------------------------------------------- */

  .alsaadah-hero__overlay {
    z-index: -1;

    background:
      linear-gradient(
        90deg,
        rgba(4, 43, 29, 0.90) 0%,
        rgba(4, 43, 29, 0.80) 22%,
        rgba(4, 43, 29, 0.60) 38%,
        rgba(4, 43, 29, 0.28) 53%,
        rgba(4, 43, 29, 0.08) 66%,
        rgba(4, 43, 29, 0) 78%
      );
  }

  /* ---------------------------------------------------------
     INNER LAYOUT
     --------------------------------------------------------- */

  .alsaadah-hero__inner {
    width: 100%;
    box-sizing: border-box;

    padding-block: 76px;
    padding-inline: clamp(32px, 4.5vw, 76px);
  }

  .alsaadah-hero__content {
    width: min(560px, 42vw);
    max-width: 560px;

    margin: 0 auto 0 0;

    text-align: left;
  }

  /* ---------------------------------------------------------
     EYEBROW
     --------------------------------------------------------- */

  .alsaadah-hero__eyebrow {
    margin: 0 0 14px;

    color: rgba(255, 255, 255, 0.94);

    font-size: 12px;
    line-height: 1.2;
    font-weight: 700;

    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  /* ---------------------------------------------------------
     HEADING
     --------------------------------------------------------- */

  .alsaadah-hero__heading {
    max-width: 560px;
    margin: 0;

    color: #ffffff;

    font-size: clamp(42px, 4.35vw, 66px);
    line-height: 1;
    font-weight: 750;

    letter-spacing: -0.038em;

    text-wrap: balance;
  }

  /* ---------------------------------------------------------
     DESCRIPTION
     --------------------------------------------------------- */

  .alsaadah-hero__description {
    max-width: 500px;
    margin-top: 22px;

    color: rgba(255, 255, 255, 0.92);

    font-size: clamp(16px, 1.2vw, 19px);
    line-height: 1.52;
    font-weight: 400;
  }

  .alsaadah-hero__description p {
    margin: 0;
  }

  /* ---------------------------------------------------------
     PRIMARY CTA
     Red is intentionally reserved for the primary action
     --------------------------------------------------------- */

  .alsaadah-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;

    min-height: 52px;

    margin-top: 28px;
    padding-inline: 24px;

    border: 0;
    border-radius: 12px;

    background: #e30613;
    color: #ffffff;

    font-size: 16px;
    line-height: 1;
    font-weight: 700;

    text-decoration: none;

    box-shadow:
      0 7px 20px rgba(0, 0, 0, 0.16);

    transition:
      transform 180ms ease,
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .alsaadah-hero__button:hover {
    background: #c90012;

    transform: translateY(-2px);

    box-shadow:
      0 11px 28px rgba(0, 0, 0, 0.22);
  }

  .alsaadah-hero__button:focus-visible {
    outline: 3px solid #ffffff;
    outline-offset: 4px;
  }

  .alsaadah-hero__button-arrow {
    display: inline-block;

    font-size: 20px;
    line-height: 1;

    transition: transform 180ms ease;
  }

  .alsaadah-hero__button:hover .alsaadah-hero__button-arrow {
    transform: translateX(4px);
  }

  /* =========================================================
     LARGE DESKTOP
     ========================================================= */

  @media screen and (min-width: 1440px) {
    .alsaadah-hero {
      min-height: 600px;
    }

    .alsaadah-hero__inner {
      padding-inline: clamp(64px, 5vw, 96px);
    }

    .alsaadah-hero__content {
      width: min(590px, 40vw);
      max-width: 590px;
    }

    .alsaadah-hero__heading {
      max-width: 590px;

      font-size: clamp(52px, 4vw, 70px);
    }

    .alsaadah-hero__description {
      max-width: 510px;
    }

    .alsaadah-hero__image {
      object-position: 70% center;
    }
  }

  /* =========================================================
     TABLET / SMALL LAPTOP
     ========================================================= */

  @media screen and (max-width: 989px) {
    .alsaadah-hero {
      min-height: 520px;
    }

    .alsaadah-hero__inner {
      padding-block: 60px;
      padding-inline: 40px;
    }

    .alsaadah-hero__content {
      width: min(500px, 58vw);
      max-width: 500px;
    }

    .alsaadah-hero__heading {
      max-width: 490px;

      font-size: clamp(40px, 6vw, 56px);
      line-height: 1.01;
    }

    .alsaadah-hero__description {
      max-width: 450px;

      font-size: 16px;
    }

    .alsaadah-hero__image {
      object-position: 72% center;
    }

    .alsaadah-hero__overlay {
      background:
        linear-gradient(
          90deg,
          rgba(4, 43, 29, 0.92) 0%,
          rgba(4, 43, 29, 0.78) 34%,
          rgba(4, 43, 29, 0.44) 55%,
          rgba(4, 43, 29, 0.12) 74%,
          rgba(4, 43, 29, 0) 100%
        );
    }
  }

  /* =========================================================
     MOBILE
     Image remains visible above/right,
     copy moves toward the bottom.
     ========================================================= */

  @media screen and (max-width: 749px) {
    .alsaadah-hero {
      min-height: 620px;
      align-items: flex-end;
    }

    .alsaadah-hero__image {
      object-position: 72% center;
    }

    .alsaadah-hero__overlay {
      background:
        linear-gradient(
          0deg,
          rgba(4, 43, 29, 0.98) 0%,
          rgba(4, 43, 29, 0.91) 28%,
          rgba(4, 43, 29, 0.72) 48%,
          rgba(4, 43, 29, 0.30) 69%,
          rgba(4, 43, 29, 0.04) 88%,
          rgba(4, 43, 29, 0) 100%
        );
    }

    .alsaadah-hero__inner {
      padding:
        200px
        24px
        40px;
    }

    .alsaadah-hero__content {
      width: 100%;
      max-width: 100%;
    }

    .alsaadah-hero__eyebrow {
      margin-bottom: 10px;

      font-size: 11px;

      letter-spacing: 0.14em;
    }

    .alsaadah-hero__heading {
      max-width: 520px;

      font-size: clamp(36px, 10vw, 48px);
      line-height: 1.01;

      letter-spacing: -0.03em;
    }

    .alsaadah-hero__description {
      max-width: 500px;

      margin-top: 18px;

      font-size: 16px;
      line-height: 1.45;
    }

    .alsaadah-hero__button {
      min-height: 50px;

      margin-top: 24px;
      padding-inline: 22px;

      border-radius: 10px;
    }
  }

  /* =========================================================
     SMALL MOBILE
     ========================================================= */

  @media screen and (max-width: 480px) {
    .alsaadah-hero {
      min-height: 600px;
    }

    .alsaadah-hero__image {
      object-position: 70% center;
    }

    .alsaadah-hero__inner {
      padding:
        190px
        20px
        34px;
    }

    .alsaadah-hero__heading {
      max-width: 390px;

      font-size: clamp(34px, 10.5vw, 42px);
    }

    .alsaadah-hero__description {
      max-width: 390px;

      font-size: 15px;
    }
  }

  /* =========================================================
     VERY SMALL MOBILE
     ========================================================= */

  @media screen and (max-width: 380px) {
    .alsaadah-hero {
      min-height: 580px;
    }

    .alsaadah-hero__inner {
      padding:
        170px
        18px
        30px;
    }

    .alsaadah-hero__heading {
      font-size: 33px;
    }

    .alsaadah-hero__button {
      width: 100%;
      max-width: 260px;
    }
  }

  /* =========================================================
     ACCESSIBILITY
     ========================================================= */

  @media (prefers-reduced-motion: reduce) {
    .alsaadah-hero__button,
    .alsaadah-hero__button-arrow {
      transition: none;
    }

    .alsaadah-hero__button:hover,
    .alsaadah-hero__button:hover .alsaadah-hero__button-arrow {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ALSAADAH Hero",
  "tag": "section",
  "class": "alsaadah-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ALSAADAH ÖSTERREICH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Authentischer Geschmack. Einfach entdeckt."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Ausgewählte Spezialitäten aus der Levante – für Handel, Gastronomie und Genießer in Österreich.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Produkte entdecken"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "ALSAADAH Hero"
    }
  ]
}
{% endschema %}