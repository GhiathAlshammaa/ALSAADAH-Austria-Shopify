{% liquid
  assign products_url = section.settings.products_url | default: routes.all_products_collection_url
%}

<section class="alsaadah-about">
  <div class="alsaadah-about__inner">
    <div class="alsaadah-about__hero">
      <p class="alsaadah-about__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.heading }}</h1>
      <p class="alsaadah-about__lead">{{ section.settings.lead }}</p>
      <div class="alsaadah-about__intro rte">
        {{ section.settings.intro }}
      </div>
    </div>

    <div class="alsaadah-about__story">
      <div>
        <p class="alsaadah-about__eyebrow">{{ section.settings.story_eyebrow }}</p>
        <h2>{{ section.settings.story_heading }}</h2>
      </div>
      <div class="rte">{{ section.settings.story_text }}</div>
    </div>

    <div class="alsaadah-about__values">
      <article class="alsaadah-about__card">
        <span>01</span>
        <h3>Authentischer Geschmack</h3>
        <p>Produkte mit dem charakteristischen Geschmack ihrer traditionellen Küche.</p>
      </article>
      <article class="alsaadah-about__card">
        <span>02</span>
        <h3>Sorgfältige Auswahl</h3>
        <p>Ein fokussiertes Sortiment statt einer unübersichtlichen Masse an Produkten.</p>
      </article>
      <article class="alsaadah-about__card">
        <span>03</span>
        <h3>Klare Produktinformation</h3>
        <p>Übersichtliche Größen, verständliche Produktdetails und eine einfache Auswahl.</p>
      </article>
      <article class="alsaadah-about__card">
        <span>04</span>
        <h3>Verlässlich in Österreich</h3>
        <p>Eine starke Marke für Kunden, Handel und Gastronomie in Österreich.</p>
      </article>
    </div>

    <div class="alsaadah-about__cta">
      <div>
        <p class="alsaadah-about__eyebrow">ALSAADAH AUSTRIA</p>
        <h2>{{ section.settings.cta_heading }}</h2>
      </div>
      <a class="alsaadah-about__button" href="{{ products_url }}">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% stylesheet %}
  .alsaadah-about{background:#fff;color:#24352e;padding:clamp(56px,7vw,104px) 0}
  .alsaadah-about__inner{width:min(1120px,calc(100% - 40px));margin:auto}
  .alsaadah-about__hero{max-width:820px;margin-bottom:clamp(64px,8vw,112px)}
  .alsaadah-about__eyebrow{margin:0 0 14px;color:#e30613;font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
  .alsaadah-about h1{margin:0;color:#083b29;font-size:clamp(48px,7vw,88px);line-height:.98;letter-spacing:-.045em}
  .alsaadah-about__lead{margin:24px 0 20px;color:#083b29;font-size:clamp(24px,3vw,38px);font-weight:700;line-height:1.15}
  .alsaadah-about__intro{max-width:720px;font-size:18px;line-height:1.75;color:#48564f}
  .alsaadah-about__story{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(36px,7vw,96px);padding:clamp(40px,6vw,72px);background:#f8f6f1;border-radius:28px;margin-bottom:30px}
  .alsaadah-about h2{margin:0;color:#083b29;font-size:clamp(32px,4vw,52px);line-height:1.05;letter-spacing:-.03em}
  .alsaadah-about__story .rte{font-size:17px;line-height:1.8}
  .alsaadah-about__values{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin:18px 0 64px}
  .alsaadah-about__card{padding:30px;border:1px solid #e9ece8;border-radius:22px;background:#fff}
  .alsaadah-about__card span{display:inline-block;margin-bottom:30px;color:#e30613;font-size:13px;font-weight:800}
  .alsaadah-about__card h3{margin:0 0 10px;color:#083b29;font-size:22px}
  .alsaadah-about__card p{margin:0;color:#5d6862;line-height:1.65}
  .alsaadah-about__cta{display:flex;align-items:center;justify-content:space-between;gap:28px;padding:clamp(32px,5vw,56px);background:#083b29;color:#fff;border-radius:28px}
  .alsaadah-about__cta h2{color:#fff;max-width:720px}
  .alsaadah-about__button{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 24px;border-radius:999px;background:#e30613;color:#fff!important;text-decoration:none;font-weight:700;white-space:nowrap}
  .alsaadah-about__button:hover{opacity:.9}
  @media(max-width:749px){
    .alsaadah-about__inner{width:min(100% - 28px,1120px)}
    .alsaadah-about__story{grid-template-columns:1fr;padding:30px 24px}
    .alsaadah-about__values{grid-template-columns:1fr}
    .alsaadah-about__cta{align-items:flex-start;flex-direction:column}
    .alsaadah-about__button{width:100%}
  }
{% endstylesheet %}

{% schema %}
{
  "name": "ALSAADAH About",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "ALSAADAH AUSTRIA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Über uns"
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Lead",
      "default": "Geschmack, der verbindet."
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Einleitung",
      "default": "<p>ALSAADAH Austria steht für ausgewählte Lebensmittel und Spezialitäten mit authentischem Geschmack. Unser Ziel ist es, Produkte, die in der orientalischen Küche seit langem geschätzt werden, einfach und zuverlässig in Österreich verfügbar zu machen.</p><p>Von Oliven und Makdous bis hin zu Halva und weiteren Feinkostprodukten wählen wir unser Sortiment mit Fokus auf Geschmack, Qualität und Alltagstauglichkeit aus.</p>"
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Story Eyebrow",
      "default": "UNSERE IDEE"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story Überschrift",
      "default": "Einfach gute Produkte."
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Text",
      "default": "<p>Gutes Essen braucht keine komplizierte Geschichte. Es braucht gute Zutaten, vertraute Aromen und Produkte, auf die man sich verlassen kann.</p><p>Deshalb möchten wir ein übersichtliches Sortiment anbieten, das sowohl für den täglichen Genuss zu Hause als auch für Gastronomie und Handel interessant ist.</p>"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "CTA Überschrift",
      "default": "Authentischer Geschmack. Einfach entdeckt."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button",
      "default": "Produkte entdecken"
    },
    {
      "type": "url",
      "id": "products_url",
      "label": "CTA Link"
    }
  ],
  "presets": [
    {
      "name": "ALSAADAH About"
    }
  ]
}
{% endschema %}
