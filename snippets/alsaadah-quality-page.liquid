{% assign products_url = routes.all_products_collection_url %}

<section class="alsaadah-quality-page">
  <div class="alsaadah-quality-page__inner">
    <div class="alsaadah-quality-page__hero">
      <div class="alsaadah-quality-page__hero-copy">
        <p class="alsaadah-quality-page__eyebrow">ALSAADAH AUSTRIA</p>
        <h1>Qualität</h1>
        <p class="alsaadah-quality-page__lead">Qualität beginnt bei der Auswahl.</p>
        <p class="alsaadah-quality-page__intro">
          Bei ALSAADAH Austria bedeutet Qualität vor allem: Produkte bewusst auszuwählen,
          verständlich zu präsentieren und ein Sortiment anzubieten, auf das man sich im Alltag verlassen kann.
        </p>
      </div>
      <div class="alsaadah-quality-page__seal" aria-hidden="true">
        <span>Ausgewählt</span>
        <strong>mit Fokus auf<br>Geschmack & Klarheit</strong>
      </div>
    </div>

    <div class="alsaadah-quality-page__section-head">
      <p class="alsaadah-quality-page__eyebrow">WORAUF WIR ACHTEN</p>
      <h2>Einfach nachvollziehbare Qualität.</h2>
    </div>

    <div class="alsaadah-quality-page__grid">
      <article>
        <span>01</span>
        <h3>Authentischer Geschmack</h3>
        <p>Wir wählen Spezialitäten, die für den charakteristischen Geschmack ihrer traditionellen Küche geschätzt werden.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Sorgfältige Auswahl</h3>
        <p>Ein fokussiertes Sortiment hilft dabei, gute Produkte leichter zu entdecken und sinnvoll miteinander zu vergleichen.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Klare Produktinformation</h3>
        <p>Größen, Produktdetails und Verwendungsmöglichkeiten sollen schnell verständlich und übersichtlich dargestellt sein.</p>
      </article>
      <article>
        <span>04</span>
        <h3>Für Alltag und Gastronomie</h3>
        <p>Unsere Auswahl richtet sich sowohl an Genießer zu Hause als auch an Handel und Gastronomie.</p>
      </article>
    </div>

    <div class="alsaadah-quality-page__principles">
      <div>
        <p class="alsaadah-quality-page__eyebrow">UNSER ANSPRUCH</p>
        <h2>Weniger Versprechen.<br>Mehr Klarheit.</h2>
      </div>
      <div class="alsaadah-quality-page__principles-copy">
        <p>
          Gute Lebensmittel brauchen keine komplizierte Sprache. Deshalb setzen wir auf eine klare Auswahl,
          nachvollziehbare Informationen und Produkte, deren Charakter im Mittelpunkt steht.
        </p>
        <div class="alsaadah-quality-page__tags">
          <span>Geschmack</span>
          <span>Auswahl</span>
          <span>Übersicht</span>
          <span>Alltagstauglichkeit</span>
        </div>
      </div>
    </div>

    <div class="alsaadah-quality-page__cta">
      <div>
        <p class="alsaadah-quality-page__eyebrow">UNSER SORTIMENT</p>
        <h2>Qualität, die man entdecken kann.</h2>
      </div>
      <a href="{{ products_url }}">Produkte entdecken</a>
    </div>
  </div>
</section>

<style>
.alsaadah-quality-page{background:#fff;color:#26372f;padding:clamp(56px,7vw,104px) 0}
.alsaadah-quality-page__inner{width:min(1120px,calc(100% - 40px));margin:auto}
.alsaadah-quality-page__hero{display:grid;grid-template-columns:1.35fr .65fr;gap:48px;align-items:end;padding:clamp(42px,6vw,72px);background:#083b29;border-radius:30px;color:#fff;margin-bottom:clamp(68px,8vw,110px)}
.alsaadah-quality-page__eyebrow{margin:0 0 14px;color:#e30613;font-size:12px;font-weight:800;letter-spacing:.16em;text-transform:uppercase}
.alsaadah-quality-page__hero .alsaadah-quality-page__eyebrow{color:#ff6b73}
.alsaadah-quality-page h1{margin:0;font-size:clamp(52px,7vw,90px);line-height:.95;letter-spacing:-.045em;color:#fff}
.alsaadah-quality-page__lead{margin:24px 0 14px;font-size:clamp(24px,3vw,38px);font-weight:700;line-height:1.15}
.alsaadah-quality-page__intro{max-width:720px;margin:0;color:#e4ece8;font-size:18px;line-height:1.75}
.alsaadah-quality-page__seal{justify-self:end;width:min(250px,100%);aspect-ratio:1;border:1px solid rgba(255,255,255,.32);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:26px}
.alsaadah-quality-page__seal span{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:#b9d1c7;margin-bottom:10px}
.alsaadah-quality-page__seal strong{font-size:20px;line-height:1.25}
.alsaadah-quality-page__section-head{max-width:720px;margin-bottom:30px}
.alsaadah-quality-page h2{margin:0;color:#083b29;font-size:clamp(34px,4vw,54px);line-height:1.05;letter-spacing:-.03em}
.alsaadah-quality-page__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-bottom:clamp(68px,8vw,110px)}
.alsaadah-quality-page__grid article{padding:32px;border:1px solid #e7ebe8;border-radius:22px;background:#fff}
.alsaadah-quality-page__grid article>span{display:inline-block;margin-bottom:34px;color:#e30613;font-size:13px;font-weight:800}
.alsaadah-quality-page__grid h3{margin:0 0 10px;color:#083b29;font-size:23px}
.alsaadah-quality-page__grid p{margin:0;color:#5d6862;line-height:1.7}
.alsaadah-quality-page__principles{display:grid;grid-template-columns:.9fr 1.1fr;gap:clamp(36px,7vw,92px);padding:clamp(38px,6vw,70px);background:#f8f6f1;border-radius:28px;margin-bottom:34px}
.alsaadah-quality-page__principles-copy{font-size:17px;line-height:1.8;color:#48564f}
.alsaadah-quality-page__principles-copy p{margin-top:0}
.alsaadah-quality-page__tags{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
.alsaadah-quality-page__tags span{padding:9px 14px;border:1px solid #d7ddd8;border-radius:999px;background:#fff;color:#083b29;font-size:14px;font-weight:650}
.alsaadah-quality-page__cta{display:flex;align-items:center;justify-content:space-between;gap:28px;padding:clamp(32px,5vw,56px);border-radius:28px;background:#083b29}
.alsaadah-quality-page__cta h2{color:#fff}
.alsaadah-quality-page__cta .alsaadah-quality-page__eyebrow{color:#ff6b73}
.alsaadah-quality-page__cta a{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:0 24px;border-radius:999px;background:#e30613;color:#fff;text-decoration:none;font-weight:700;white-space:nowrap}
.alsaadah-quality-page__cta a:hover{opacity:.9}
@media(max-width:749px){
  .alsaadah-quality-page__inner{width:min(100% - 28px,1120px)}
  .alsaadah-quality-page__hero{grid-template-columns:1fr;padding:32px 24px}
  .alsaadah-quality-page__seal{justify-self:start;width:180px}
  .alsaadah-quality-page__grid{grid-template-columns:1fr}
  .alsaadah-quality-page__principles{grid-template-columns:1fr;padding:30px 24px}
  .alsaadah-quality-page__cta{align-items:flex-start;flex-direction:column}
  .alsaadah-quality-page__cta a{width:100%}
}
</style>